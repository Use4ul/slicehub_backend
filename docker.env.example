# ===========================================
# SliceHub Backend - Docker Environment Variables
# ===========================================
# Copy this file to .env and adjust values for your environment

# Application Settings
NODE_ENV=production
PORT=3001

# PostgreSQL Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=slicehub
DB_USER=slicehub_user
DB_PASSWORD=change_this_password_in_production
DB_SCHEMA=slicehub

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# S3/MinIO Storage
# For production, use strong credentials!
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change_this_in_production
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# NATS Messaging
NATS_URL=nats://nats:4222

# Mock Seeds Control
# Set to "true" to generate test data on first run (переопределяет conf.json)
ENABLE_MOCK_SEEDS=false
# Number of times to run mock seeds (1-10 recommended)
MOCK_SEEDS_RUN_COUNT=1

# External Ports (change if ports are already in use)
APP_PORT=3001
DB_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
NATS_CLIENT_PORT=4222
NATS_MONITORING_PORT=8222

# Security (add in production)
# JWT_SECRET=your-secret-key-min-32-chars
# SESSION_SECRET=your-session-secret

# Monitoring
MONITORING_ENABLED=true

# Logging
LOG_LEVEL=info

# ===========================================
# Production Security Checklist:
# ===========================================
# [ ] Change DB_PASSWORD to strong password (min 16 chars)
# [ ] Change S3_SECRET_ACCESS_KEY to strong password (min 16 chars)
# [ ] Set REDIS_PASSWORD
# [ ] Generate JWT_SECRET (use: openssl rand -base64 32)
# [ ] Generate SESSION_SECRET (use: openssl rand -base64 32)
# [ ] Use HTTPS/SSL certificates
# [ ] Configure firewall rules
# [ ] Set up backup strategy
# [ ] Configure log rotation
# [ ] Review and restrict exposed ports

